{
  "boot-source": {
    "kernel_image_path": "assets/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 init=/init"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "assets/rust-cratesio.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 1024
  },
  "network-interfaces": [
    {
      "iface_id": "net0",
      "guest_mac": "AA:FC:00:00:00:02",
      "host_dev_name": "tap1"
    }
  ]
}